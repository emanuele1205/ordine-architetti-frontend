{
  "name": "Ordine Architetti P.P.C. Caltanissetta",
  "short_name": "OAPPC CL",
  "description": "App ufficiale dell'Ordine degli Architetti, Pianificatori, Paesaggisti e Conservatori della Provincia di Caltanissetta. Connettiti con la comunità professionale, trova architetti qualificati, iscriviti ai corsi CFP e gestisci la tua attività.",
  "version": "1.0.0",
  "manifest_version": 1,
  
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "lang": "it-IT",
  "dir": "ltr",
  
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  
  "categories": [
    "business", 
    "productivity", 
    "professional", 
    "networking",
    "education"
  ],
  
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon",
      "purpose": "any"
    },
    {
      "src": "logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "logo512.png",
      "type": "image/png", 
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "logo512.png",
      "type": "image/png",
      "sizes": "512x512", 
      "purpose": "maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "screenshots/mobile-home.png",
      "sizes": "375x812",
      "type": "image/png",
      "platform": "narrow",
      "label": "Home page dell'app su mobile"
    },
    {
      "src": "screenshots/mobile-search.png", 
      "sizes": "375x812",
      "type": "image/png",
      "platform": "narrow",
      "label": "Ricerca architetti nell'albo professionale"
    },
    {
      "src": "screenshots/mobile-courses.png",
      "sizes": "375x812", 
      "type": "image/png",
      "platform": "narrow",
      "label": "Sezione corsi di formazione CFP"
    },
    {
      "src": "screenshots/desktop-dashboard.png",
      "sizes": "1280x800",
      "type": "image/png", 
      "platform": "wide",
      "label": "Dashboard completa su desktop"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Cerca Architetti",
      "short_name": "Cerca",
      "description": "Trova architetti qualificati nell'albo professionale",
      "url": "/?shortcut=search",
      "icons": [
        {
          "src": "icons/shortcut-search.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Corsi CFP",
      "short_name": "Corsi", 
      "description": "Visualizza e iscriviti ai corsi di formazione continua",
      "url": "/?shortcut=courses",
      "icons": [
        {
          "src": "icons/shortcut-courses.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Messaggi",
      "short_name": "Chat",
      "description": "Accedi alla messaggistica professionale",
      "url": "/?shortcut=chat",
      "icons": [
        {
          "src": "icons/shortcut-chat.png", 
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Il Mio Profilo",
      "short_name": "Profilo",
      "description": "Gestisci il tuo profilo professionale",
      "url": "/?shortcut=profile", 
      "icons": [
        {
          "src": "icons/shortcut-profile.png",
          "sizes": "96x96", 
          "type": "image/png"
        }
      ]
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/?action=email&to=%s"
    },
    {
      "protocol": "tel", 
      "url": "/?action=call&number=%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/?action=view-document",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/msword": [".doc"],
        "image/jpeg": [".jpg", ".jpeg"], 
        "image/png": [".png"]
      }
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "id": "it.caltanissetta.architetti",
      "url": "https://play.google.com/store/apps/details?id=it.caltanissetta.architetti"
    },
    {
      "platform": "itunes",
      "id": "123456789",
      "url": "https://apps.apple.com/it/app/oappc-caltanissetta/id123456789"
    }
  ],
  "prefer_related_applications": false,

  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "handle_links": "preferred",
  
  "capture_links": "existing-client-navigate",

  "share_target": {
    "action": "/?action=share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text", 
      "url": "url",
      "files": [
        {
          "name": "documents",
          "accept": ["application/pdf", ".pdf", "image/*", ".doc", ".docx"]
        }
      ]
    }
  },

  "note_taking": {
    "new_note_url": "/?action=new-note"
  },

  "permissions": [
    "geolocation",
    "notifications",
    "persistent-storage"
  ],

  "gcm_sender_id": "103953800507",

  "features": [
    {
      "name": "Cross Platform",
      "description": "Funziona su tutti i dispositivi"
    },
    {
      "name": "Offline Support", 
      "description": "Accesso ai dati anche senza connessione"
    },
    {
      "name": "Push Notifications",
      "description": "Ricevi notifiche per aggiornamenti importanti"
    },
    {
      "name": "Professional Network",
      "description": "Connettiti con altri professionisti"
    }
  ]
}